# Copy to apps/api/.env and fill in. Never commit the real .env.

# Port the API listens on locally. Render sets PORT instead.
API_PORT=4000

# Comma-separated list of web origins allowed by CORS.
WEB_ORIGIN=http://localhost:3001

# Neon Postgres connection string (the pooled one is fine; migrations
# derive the direct connection automatically).
DATABASE_URL=

# Football data. Set whichever keys you have:
# - API-Football: live scores, events, line-ups (the fast feed)
# - football-data.org: tables, season fixtures, top scorers
# With neither, only demo matches are shown.
API_FOOTBALL_KEY=
FOOTBALL_DATA_TOKEN=

# Plan limits (free plans by default).
API_FOOTBALL_DAILY_LIMIT=100
FOOTBALL_DATA_MINUTE_LIMIT=10

# Demo matches that always play live, labelled "Demo" (true/false).
DEMO_ENABLED=true

# Background ingest worker (true/false). Tests turn it off automatically.
INGEST_ENABLED=true

# Optional: Upstash Redis for cache/pub-sub. Leave empty for in-memory.
REDIS_URL=

# Web Push (VAPID) keys, generated in milestone 6.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
