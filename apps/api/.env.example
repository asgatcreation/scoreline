# Copy to apps/api/.env and fill in. Never commit the real .env.

# Port the API listens on (Render sets this automatically).
PORT=4000

# Comma-separated list of web origins allowed by CORS.
WEB_ORIGIN=http://localhost:3001

# Neon Postgres connection string (added in milestone 3).
DATABASE_URL=

# Data provider: "demo", "api-football" or "football-data".
PROVIDER=demo
API_FOOTBALL_KEY=
FOOTBALL_DATA_TOKEN=

# Optional: Upstash Redis for cache/pub-sub. Leave empty for in-memory.
REDIS_URL=

# Web Push (VAPID) keys, generated in milestone 6.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
